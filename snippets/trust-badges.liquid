{% comment %}Honest trust badges — every claim must be verifiable. Do not add reviews, discounts or urgency here.{% endcomment %}
<div class="trust-badges" role="list">
  <div class="trust-badge" role="listitem"><span class="trust-icon">{% render 'icon', icon: 'shield' %}</span><span><strong>30-Day Returns</strong><em>Easy returns within 30 days of delivery.</em></span></div>
  <div class="trust-badge" role="listitem"><span class="trust-icon">{% render 'icon', icon: 'truck' %}</span><span><strong>Free Tracking on Every Order</strong><em>Tracking provided by email when available.</em></span></div>
  <div class="trust-badge" role="listitem"><span class="trust-icon">{% render 'icon', icon: 'lock' %}</span><span><strong>Secure Checkout</strong><em>Checkout powered by Shopify's secure platform.</em></span></div>
  <div class="trust-badge" role="listitem"><span class="trust-icon">{% render 'icon', icon: 'recycle' %}</span><span><strong>Reusable — No Refills</strong><em>Roll, empty, and use it again.</em></span></div>
</div>
