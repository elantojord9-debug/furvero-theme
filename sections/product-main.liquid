{% assign product = section.settings.product | default: product %}<section class="section" id="product"><div class="container product-layout"><div class="product-media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | escape | default: product.title | escape }}">{% endif %}</div><div class="buy-box"><div class="eyebrow">FURVERO™</div><h1>{{ product.title }}</h1>{% render 'price', product: product %}<p>{{ product.description | strip_html | truncate: 300 }}</p>{% render 'buy-buttons', product: product %}<div class="trust"><span class="pill">Reusable</span><span class="pill">Battery-free</span><span class="pill">Secure checkout</span></div></div></div></section><div class="sticky-atc"><a class="btn btn-primary" href="#product">Shop Furvero — {{ product.price | money }}</a></div>
{% schema %}{"name":"Product main","settings":[{"type":"product","id":"product","label":"Product"}],"presets":[{"name":"Product main"}]}{% endschema %}
