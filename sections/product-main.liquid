{% assign product = section.settings.product | default: product %}<section class="section" id="product"><div class="container product-layout"><div class="product-media">{% if product.featured_image %}<img id="GalleryMain-{{ section.id }}" class="gallery-main" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | escape | default: product.title | escape }}" fetchpriority="high">{% endif %}{% if product.images.size > 1 %}<div class="gallery-thumbs" role="list">{% for image in product.images %}<button type="button" class="gallery-thumb{% if image == product.featured_image %} is-active{% endif %}" data-gallery-src="{{ image | image_url: width: 1200 }}" data-gallery-alt="{{ image.alt | escape | default: product.title | escape }}" aria-label="View image {{ forloop.index }}" role="listitem"><img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape | default: product.title | escape }}" loading="lazy"></button>{% endfor %}</div>{% endif %}</div><div class="buy-box"><div class="eyebrow">FURVERO™</div><h1>{{ product.title }}</h1>{% render 'price', product: product %}<div class="product-description">{{ product.description }}</div>{% render 'buy-buttons', product: product %}<p class="ship-line">Estimated delivery: 5–11 days · Tracking provided when available</p>{% render 'trust-badges' %}</div></div></section><div class="sticky-atc"><a class="btn btn-primary" href="#product">Shop Furvero — {{ product.price | money }}</a></div>
{% schema %}{"name":"Product main","settings":[{"type":"product","id":"product","label":"Product"}],"presets":[{"name":"Product main"}]}{% endschema %}
