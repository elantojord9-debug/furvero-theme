<section class="section"><div class="container section-head"><div class="eyebrow">SHOP MORE, SAVE MORE</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div class="container cards">{% for block in section.blocks %}<article class="card" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p>{% if block.settings.product != blank %}<a class="btn btn-primary" href="{{ block.settings.product.url }}">Shop {{ block.settings.title }}</a>{% endif %}</article>{% endfor %}</div></section>
{% schema %}{"name":"Bundles","settings":[{"type":"text","id":"heading","label":"Heading","default":"Choose what fits your home."},{"type":"textarea","id":"text","label":"Text","default":"Configure real products or Shopify bundle products here. Prices come directly from Shopify."}],"blocks":[{"type":"bundle","name":"Bundle","settings":[{"type":"text","id":"title","label":"Title","default":"Single"},{"type":"textarea","id":"description","label":"Description","default":"One Furvero for everyday cleanup."},{"type":"product","id":"product","label":"Shopify product"}]}],"presets":[{"name":"Bundles"}]}{% endschema %}
