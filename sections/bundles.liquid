<section class="section" id="bundles"><div class="container section-head"><div class="eyebrow">SHOP MORE, SAVE MORE</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div class="container cards">{% for block in section.blocks %}<article class="card bundle-card" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><div class="bundle-price">{{ block.settings.price }}</div><p>{{ block.settings.description }}</p>{% if block.settings.product != blank %}<a class="btn btn-primary" href="{{ block.settings.product.url }}">Shop {{ block.settings.title }}</a>{% endif %}</article>{% endfor %}</div></section>
{% schema %}{"name":"Bundles","settings":[{"type":"text","id":"heading","label":"Heading","default":"Choose your bundle."},{"type":"textarea","id":"text","label":"Text","default":"Real bundles, honest savings — priced per pack, no fake discounts."}],"blocks":[{"type":"bundle","name":"Bundle","settings":[{"type":"text","id":"title","label":"Title","default":"Single"},{"type":"text","id":"price","label":"Price","default":"$19.99"},{"type":"textarea","id":"description","label":"Description","default":"One Furvero for everyday cleanup."},{"type":"product","id":"product","label":"Shopify product"}]}],"presets":[{"name":"Bundles"}]}{% endschema %}
