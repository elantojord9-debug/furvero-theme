<section id="how-it-works" class="section alt"><div class="container section-head"><div class="eyebrow">HOW IT WORKS</div><h2>{{ section.settings.heading }}</h2></div><div class="container cards">{% for block in section.blocks %}<article class="card" {{ block.shopify_attributes }}><div class="number">0{{ forloop.index }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></section>
{% schema %}{"name":"How it works","settings":[{"type":"text","id":"heading","label":"Heading","default":"Three simple steps."}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"title","label":"Title","default":"Swipe"},{"type":"textarea","id":"text","label":"Text","default":"Move Furvero across the fabric surface."}]}],"presets":[{"name":"How it works","blocks":[{"type":"step","settings":{"title":"Swipe","text":"Move Furvero across the fabric surface."}},{"type":"step","settings":{"title":"Collect","text":"The tool gathers loose pet hair."}},{"type":"step","settings":{"title":"Empty & reuse","text":"Empty it and keep it ready for the next cleanup."}}]}]}{% endschema %}
