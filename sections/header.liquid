<header class="site-header"><div class="container header-inner"><a class="brand" href="/">{% if settings.logo %}<img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ settings.logo_alt | escape }}">{% else %}FURVERO{% endif %}</a><nav class="nav"><a href="/#how-it-works">How It Works</a><a href="/#why-furvero">Why Furvero</a><a href="/#faq">FAQ</a></nav><button class="icon-btn" data-open-cart aria-label="Open cart">{% render 'icon', icon:'cart' %}<span class="cart-count" data-cart-count>0</span></button></div></header>
{% schema %}{"name":"Header","settings":[],"presets":[{"name":"Header"}]}{% endschema %}
