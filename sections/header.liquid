{{- 'header — sticky, logo left, nav, SHOP NOW, cart, mobile hamburger' -}}
<header class="fv-header">
  <div class="fv-container fv-header__inner">
    <a class="fv-logo" href="{{ routes.root_url }}" aria-label="Furvero home">
      <span class="fv-logo__name">{{ section.settings.logo_text | default: 'FURVERO' }}</span>
      <span class="fv-logo__tag">{{ section.settings.slogan | default: 'LESS FUR. MORE LOVE.' }}</span>
    </a>

    <nav class="fv-nav" aria-label="Primary">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="fv-header__actions">
      <a class="fv-btn fv-btn--primary fv-header__cta" href="#buy">{{ section.settings.cta_text | default: 'SHOP NOW' }}</a>
      <button class="fv-cart-btn" id="fv-cart-open" aria-label="Open cart">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span class="fv-cart-count" id="fv-cart-count" hidden>0</span>
      </button>
      <button class="fv-hamburger" id="fv-hamburger" aria-expanded="false" aria-controls="fv-mobile-nav" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="fv-mobile-nav" id="fv-mobile-nav" aria-label="Mobile">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
    <a href="#buy">{{ section.settings.cta_text | default: 'SHOP NOW' }}</a>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "FURVERO" },
    { "type": "text", "id": "slogan", "label": "Slogan (small, under logo)", "default": "LESS FUR. MORE LOVE." },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "info": "Create a menu with: SHOP, HOW IT WORKS, FAQ" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "SHOP NOW" }
  ],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
