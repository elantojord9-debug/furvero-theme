<header class="site-header"><div class="container header-inner"><a class="brand" href="/">{% if settings.logo %}<img src="{{ settings.logo | image_url: width: 300 }}" alt="FURVERO">{% else %}<span class="brand-lockup"><img src="{{ 'furvero-logo.png' | asset_url }}" alt="FURVERO" width="168" height="114" class="brand-logo" onload="this.parentNode.classList.add('has-logo')" onerror="this.parentNode.classList.add('no-logo')"><span class="brand-text">FURVERO</span></span>{% endif %}</a><nav class="nav" data-nav>{% assign mm = linklists['main-menu'] %}{% if mm and mm.links.size > 0 %}{% for link in mm.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% else %}<a href="/#how-it-works">How It Works</a><a href="/#why-furvero">Why Furvero</a><a href="/#faq">FAQ</a>{% endif %}</nav><button class="icon-btn nav-toggle" data-nav-toggle aria-label="Open menu" aria-expanded="false">{% render 'icon', icon:'menu' %}</button><button class="icon-btn" data-open-cart aria-label="Open cart">{% render 'icon', icon:'cart' %}<span class="cart-count" data-cart-count>0</span></button></div></header>
{% schema %}{"name":"Header","settings":[],"presets":[{"name":"Header"}]}{% endschema %}