<section id="faq" class="section"><div class="container section-head"><div class="eyebrow">FAQ</div><h2>{{ section.settings.heading }}</h2></div><div class="container faq">{% for block in section.blocks %}<div class="faq-item" {{ block.shopify_attributes }}><button class="faq-q" type="button">{{ block.settings.question }}<span>+</span></button><div class="faq-a">{{ block.settings.answer }}</div></div>{% endfor %}</div></section>
{% schema %}{"name":"FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"Questions, answered."}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Does Furvero need batteries?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>No. Furvero is designed to be used manually.</p>"}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question","settings":{"question":"Does Furvero need batteries?","answer":"<p>No. Furvero is designed to be used manually.</p>"}},{"type":"question","settings":{"question":"What can I use it on?","answer":"<p>Use it on suitable fabric surfaces. Test delicate materials in a hidden area first.</p>"}},{"type":"question","settings":{"question":"Does it replace a vacuum?","answer":"<p>No. It is designed to complement normal cleaning for quick touch-ups.</p>"}},{"type":"question","settings":{"question":"Is it reusable?","answer":"<p>Yes. Follow the product's actual cleaning and emptying instructions.</p>"}}]}]}{% endschema %}
