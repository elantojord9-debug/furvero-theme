{{- 'faq — accessible accordion. "What if I don\'t like it?" links to the REAL
    return policy (page setting). Never invent a guarantee.' -}}
<section class="fv-section fv-section--white" id="faq">
  <div class="fv-container">
    <div class="fv-center">
      <span class="fv-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="fv-h2">{{ section.settings.headline }}</h2>
    </div>
    <div class="fv-faq">
      {%- for block in section.blocks -%}
        <details>
          <summary>{{ block.settings.question }}</summary>
          <div class="fv-faq__a">
            {%- if block.settings.use_policy_link -%}
              <p>{{ block.settings.answer }} <a href="{{ section.settings.policy_url }}">Read our return policy</a>.</p>
            {%- else -%}
              <p>{{ block.settings.answer }}</p>
            {%- endif -%}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "QUESTIONS, ANSWERED." },
    { "type": "url", "id": "policy_url", "label": "Return policy page", "info": "Link to your real Shipping/Refund policy page. Required before launch." }
  ],
  "blocks": [
    {
      "type": "qa", "name": "Q&A",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Does Furvero need batteries?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "No. Furvero is a manual reusable tool." },
        { "type": "checkbox", "id": "use_policy_link", "label": "Append link to return policy", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "Does Furvero need batteries?", "answer": "No. Furvero is a manual reusable tool." } },
        { "type": "qa", "settings": { "question": "What can I use Furvero on?", "answer": "Furvero is designed for suitable fabric surfaces such as couches, bedding, clothing and car upholstery. For delicate materials, test a small hidden area first." } },
        { "type": "qa", "settings": { "question": "Does Furvero replace my vacuum?", "answer": "No. Furvero is designed for quick everyday pet-hair cleanup and can complement your normal cleaning routine." } },
        { "type": "qa", "settings": { "question": "Is Furvero reusable?", "answer": "Yes. Furvero is designed to be reused rather than relying on disposable sticky sheets." } },
        { "type": "qa", "settings": { "question": "How do I clean Furvero?", "answer": "Remove the collected fur according to the product's actual design and keep the tool ready for the next use." } },
        { "type": "qa", "settings": { "question": "How long does shipping take?", "answer": "Shipping times depend on the destination and fulfillment location. The exact delivery estimate is shown during checkout." } },
        { "type": "qa", "settings": { "question": "What if I don't like it?", "answer": "Please see our return policy for details:", "use_policy_link": true } }
      ]
    }
  ]
}
{% endschema %}
