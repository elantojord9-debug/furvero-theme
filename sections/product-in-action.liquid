<section class="section alt"><div class="container"><div class="section-head"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div class="action-media-grid"><div class="action-media"><video autoplay muted loop playsinline preload="metadata" poster="{{ 'furvero-cj-video-poster.jpg' | asset_url }}"><source src="{{ 'furvero-cj-video.mp4' | asset_url }}" type="video/mp4"></video></div><div class="action-media"><video autoplay muted loop playsinline preload="metadata" poster="{{ 'furvero-cj-video2-poster.jpg' | asset_url }}"><source src="{{ 'furvero-cj-video2.mp4' | asset_url }}" type="video/mp4"></video></div></div><div class="action-points"><div><strong>Lifts fur fast</strong><p>Glide it over couches, bedding and clothing.</p></div><div><strong>Collects it inside</strong><p>Loose hair gathers in the chamber — no sticky sheets.</p></div><div><strong>Use it again</strong><p>Empty the chamber and roll on. No refills, no batteries.</p></div></div><div class="action-cta"><a class="btn btn-primary" href="#bundles">{{ section.settings.button }}</a></div></div></section>
{% schema %}{"name":"Product in action","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PRODUCT IN ACTION"},{"type":"text","id":"heading","label":"Heading","default":"Watch it lift the fur away."},{"type":"textarea","id":"text","label":"Text","default":"One tool, one motion. Furvero glides over fabric and pulls loose pet hair into its built-in chamber."},{"type":"text","id":"button","label":"Button label","default":"SEE THE BUNDLES"}],"presets":[{"name":"Product in action"}]}{% endschema %}
