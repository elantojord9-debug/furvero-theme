{{- 'footer — logo, link menu, copyright. Social icons ONLY if accounts exist
    (leave the social block empty until then).' -}}
<footer class="fv-footer">
  <div class="fv-container">
    <div class="fv-footer__grid">
      <div>
        <a class="fv-logo" href="{{ routes.root_url }}" aria-label="Furvero home" style="display:inline-block; margin-bottom: 14px;">
          <span class="fv-logo__name">{{ section.settings.logo_text | default: 'FURVERO' }}</span>
          <span class="fv-logo__tag">{{ section.settings.slogan | default: 'LESS FUR. MORE LOVE.' }}</span>
        </a>
        <p style="font-size: 15px; max-width: 320px;">{{ section.settings.blurb }}</p>
        {%- comment -%}
          SOCIAL ICONS: add only when real accounts exist.
          {%- for link in section.settings.social_menu.links -%} ... {%- endfor -%}
        {%- endcomment -%}
      </div>
      <nav class="fv-footer__links" aria-label="Footer">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    </div>
    <p class="fv-footer__copy">© 2026 Furvero. All rights reserved.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "FURVERO" },
    { "type": "text", "id": "slogan", "label": "Slogan", "default": "LESS FUR. MORE LOVE." },
    { "type": "textarea", "id": "blurb", "label": "Short blurb", "default": "A simple reusable tool for everyday pet-hair cleanup." },
    { "type": "link_list", "id": "menu", "label": "Footer menu", "info": "Create a menu with: Shop, How It Works, FAQ, Contact, Shipping Policy, Refund Policy, Privacy Policy, Terms of Service" }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
