<footer class="footer"><div class="container footer-grid"><div><h2>FURVERO</h2><p>{{ section.settings.text }}</p></div><div><strong>Shop</strong><p><a href="/collections/all">All products</a></p><p><a href="/pages/contact">Contact</a></p></div><div><strong>Legal</strong>{% assign fm = linklists['footer'] %}{% if fm and fm.links.size > 0 %}{% for link in fm.links %}<p><a href="{{ link.url }}">{{ link.title | escape }}</a></p>{% endfor %}{% else %}<p><a href="/policies/privacy-policy">Privacy Policy</a></p><p><a href="/policies/refund-policy">Refund Policy</a></p><p><a href="/policies/shipping-policy">Shipping Policy</a></p><p><a href="/policies/terms-of-service">Terms of Service</a></p>{% endif %}</div><div><strong>Follow</strong>{% if settings.instagram_url %}<p><a href="{{ settings.instagram_url }}">Instagram</a></p>{% endif %}{% if settings.facebook_url %}<p><a href="{{ settings.facebook_url }}">Facebook</a></p>{% endif %}{% if settings.tiktok_url %}<p><a href="{{ settings.tiktok_url }}">TikTok</a></p>{% endif %}</div></div><div class="container footer-bottom">© {{ 'now' | date: '%Y' }} Furvero. All rights reserved.</div></footer>
{% schema %}{"name":"Footer","settings":[{"type":"textarea","id":"text","label":"Text","default":"Less Fur. More Love."}],"presets":[{"name":"Footer"}]}{% endschema %}