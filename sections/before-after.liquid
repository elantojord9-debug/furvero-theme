<section class="section"><div class="container section-head"><div class="eyebrow">SEE THE DIFFERENCE</div><h2>{{ section.settings.heading }}</h2></div><div class="container before-after">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<div class="panel" {{ block.shopify_attributes }}>{% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.label | escape }}" loading="lazy">{% endif %}<div class="panel-label">{{ block.settings.label }}</div></div>{% endfor %}{% else %}<div class="panel"><img src="{{ 'furvero-inuse.jpg' | asset_url }}" alt="Using the Furvero roller on fabric" loading="lazy"><div class="panel-label">In action</div></div><div class="panel"><img src="{{ 'furvero-views.jpg' | asset_url }}" alt="Two views of the Furvero pet hair remover" loading="lazy"><div class="panel-label">Every angle</div></div>{% endif %}</div></section>
{% schema %}{"name":"Before and after","settings":[{"type":"text","id":"heading","label":"Heading","default":"One simple swipe. A cleaner-looking surface."}],"blocks":[{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"label","label":"Label","default":"In action"}]}],"presets":[{"name":"Before and after","blocks":[{"type":"image","settings":{"label":"In action"}},{"type":"image","settings":{"label":"Every angle"}}]}]}{% endschema %}
