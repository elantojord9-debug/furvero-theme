<section class="section"><div class="container section-head"><div class="eyebrow">SEE THE DIFFERENCE</div><h2>{{ section.settings.heading }}</h2></div><div class="container before-after">{% for block in section.blocks %}<div class="panel" {{ block.shopify_attributes }}>{% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.label | escape }}" loading="lazy">{% endif %}<div class="panel-label">{{ block.settings.label }}</div></div>{% endfor %}</div></section>
{% schema %}{"name":"Before and after","settings":[{"type":"text","id":"heading","label":"Heading","default":"One simple swipe. A cleaner-looking surface."}],"blocks":[{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"label","label":"Label","default":"Before"}]}],"presets":[{"name":"Before and after","blocks":[{"type":"image","settings":{"label":"Before"}},{"type":"image","settings":{"label":"After"}}]}]}{% endschema %}
