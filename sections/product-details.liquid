{{- 'product details — only confirmed facts. No invented dimensions/materials.' -}}
<section class="fv-section fv-section--white">
  <div class="fv-container">
    <div class="fv-details">
      <div>
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1000 }}"
               alt="{{ section.settings.image_alt | escape }}" loading="lazy"
               style="border-radius: var(--radius); box-shadow: var(--shadow);">
        {%- else -%}
          <!-- PLACEHOLDER: real product detail photo (see SHOT-LIST.md #9). -->
          <div class="fv-placeholder" role="img" aria-label="Product detail photo placeholder">
            <span class="fv-placeholder__label">DETAIL PHOTO — PLACEHOLDER</span>
            <span class="fv-placeholder__hint">Close-up of the roller mechanism. Real photo coming soon.</span>
          </div>
        {%- endif -%}
      </div>
      <div>
        <span class="fv-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="fv-h2">{{ section.settings.headline }}</h2>
        <ul class="fv-spec">
          {%- for block in section.blocks -%}
            <li><span class="fv-tick" aria-hidden="true">✓</span>{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product details",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "DETAILS" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "PRODUCT DETAILS" },
    { "type": "image_picker", "id": "image", "label": "Detail image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Close-up of the Furvero roller" }
  ],
  "blocks": [
    { "type": "spec", "name": "Spec", "settings": [{ "type": "text", "id": "text", "label": "Spec", "default": "Reusable design" }] }
  ],
  "presets": [
    {
      "name": "Product details",
      "blocks": [
        { "type": "spec", "settings": { "text": "Reusable design" } },
        { "type": "spec", "settings": { "text": "Manual operation" } },
        { "type": "spec", "settings": { "text": "No batteries required" } },
        { "type": "spec", "settings": { "text": "Compact and easy to store" } },
        { "type": "spec", "settings": { "text": "Designed for suitable fabric surfaces" } }
      ]
    }
  ]
}
{% endschema %}
