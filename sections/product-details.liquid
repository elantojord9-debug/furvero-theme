<section class="section alt"><div class="container details"><div><div class="eyebrow">PRODUCT DETAILS</div><h2>{{ section.settings.heading }}</h2></div><div><p>{{ section.settings.text }}</p><ul>{% if section.blocks.size > 0 %}{% for block in section.blocks %}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{% endfor %}{% else %}<li>Reusable design — no refills or sticky sheets</li><li>Battery-free, always ready</li><li>For couches, clothing, bedding and car seats</li><li>Estimated delivery 5–11 days with tracking</li>{% endif %}</ul></div></div></section>
{% schema %}{"name":"Product details","settings":[{"type":"text","id":"heading","label":"Heading","default":"Simple by design."},{"type":"textarea","id":"text","label":"Text","default":"Furvero is designed for quick everyday pet-hair cleanup without batteries or disposable sticky sheets."}],"blocks":[{"type":"detail","name":"Detail","settings":[{"type":"text","id":"text","label":"Text","default":"Reusable design"}]}],"presets":[{"name":"Product details","blocks":[{"type":"detail","settings":{"text":"Reusable design"}},{"type":"detail","settings":{"text":"Battery-free"}},{"type":"detail","settings":{"text":"Compact and easy to keep nearby"}}]}]}{% endschema %}
