<section class="section"><div class="container section-head"><div class="eyebrow">MADE FOR EVERYDAY MESSES</div><h2>{{ section.settings.heading }}</h2></div><div class="container cards">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<article class="card" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}{% else %}<article class="card"><h3>Couches</h3><p>Quick touch-ups on fabric furniture.</p></article><article class="card"><h3>Bedding</h3><p>Help remove loose fur before washing.</p></article><article class="card"><h3>Clothing</h3><p>A convenient option for everyday outfits.</p></article>{% endif %}</div></section>
{% schema %}{"name":"Use cases","settings":[{"type":"text","id":"heading","label":"Heading","default":"Keep it close to the places fur collects."}],"blocks":[{"type":"case","name":"Use case","settings":[{"type":"text","id":"title","label":"Title","default":"Couches"},{"type":"textarea","id":"text","label":"Text","default":"Quick touch-ups on fabric furniture."}]}],"presets":[{"name":"Use cases","blocks":[{"type":"case","settings":{"title":"Couches","text":"Quick touch-ups on fabric furniture."}},{"type":"case","settings":{"title":"Bedding","text":"Help remove loose fur before washing."}},{"type":"case","settings":{"title":"Clothing","text":"A convenient option for everyday outfits."}}]}]}{% endschema %}
