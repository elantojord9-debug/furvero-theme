{{- 'why furvero — 4 points + honest brand story (no invented company history)' -}}
<section class="fv-section fv-section--green">
  <div class="fv-container">
    <div class="fv-center">
      <span class="fv-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="fv-h2">{{ section.settings.headline }}</h2>
      <p class="fv-lead">{{ section.settings.intro }}</p>
    </div>
    <div class="fv-why__grid">
      {%- for block in section.blocks -%}
        <div class="fv-why__item">
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
    <div class="fv-story">
      <p>Furvero was created around a simple idea:<br>pet hair is part of having a pet.<br>Cleaning it shouldn't have to be complicated.</p>
      <p>LESS FUR. MORE LOVE.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Furvero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY FURVERO?" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "WHY FURVERO?" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Furvero is designed to make everyday pet-hair cleanup simpler without adding another complicated gadget to your home." }
  ],
  "blocks": [
    {
      "type": "point", "name": "Point",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "REUSABLE" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Built to be used again and again." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Furvero",
      "blocks": [
        { "type": "point", "settings": { "title": "REUSABLE", "text": "Built to be used again and again — no disposable sheets." } },
        { "type": "point", "settings": { "title": "SIMPLE", "text": "No learning curve. Pick it up and clean." } },
        { "type": "point", "settings": { "title": "NO BATTERIES", "text": "Manual by design. Nothing to charge, ever." } },
        { "type": "point", "settings": { "title": "MADE FOR EVERYDAY CLEANUP", "text": "For the daily fur that comes with the pets you love." } }
      ]
    }
  ]
}
{% endschema %}
