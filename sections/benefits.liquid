{{- 'benefits — 4 cards' -}}
<section class="fv-section fv-section--white">
  <div class="fv-container">
    <div class="fv-center">
      <span class="fv-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="fv-h2">{{ section.settings.headline }}</h2>
    </div>
    <div class="fv-grid-4" style="margin-top: 36px;">
      {%- for block in section.blocks -%}
        <div class="fv-benefit">
          <div class="fv-benefit__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY IT WORKS" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "A SIMPLE TOOL FOR EVERYDAY PET HAIR." }
  ],
  "blocks": [
    {
      "type": "benefit", "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "REUSABLE" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "No disposable sticky sheets to constantly replace." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "REUSABLE", "text": "No disposable sticky sheets to constantly replace." } },
        { "type": "benefit", "settings": { "title": "BATTERY-FREE", "text": "No charging. No batteries. Just use it when you need it." } },
        { "type": "benefit", "settings": { "title": "EASY TO USE", "text": "Swipe across suitable fabric surfaces and collect loose pet hair." } },
        { "type": "benefit", "settings": { "title": "READY WHEN YOU NEED IT", "text": "Keep Furvero nearby for quick cleanup." } }
      ]
    }
  ]
}
{% endschema %}
