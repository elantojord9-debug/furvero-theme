<section id="why-furvero" class="section alt"><div class="container section-head"><div class="eyebrow">WHY FURVERO</div><h2>{{ section.settings.heading }}</h2></div><div class="container cards">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<article class="card" {{ block.shopify_attributes }}><div class="number">0{{ forloop.index }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}{% else %}<article class="card"><div class="number">01</div><h3>Reusable, not disposable</h3><p>Roll, empty, repeat — no sticky sheets to rebuy.</p></article><article class="card"><div class="number">02</div><h3>Works where fur lives</h3><p>Couches, clothing, bedding and car seats.</p></article><article class="card"><div class="number">03</div><h3>Zero hassle</h3><p>No batteries, no charging, no setup.</p></article>{% endif %}</div></section>
{% schema %}{"name":"Benefits","settings":[{"type":"text","id":"heading","label":"Heading","default":"A simpler way to deal with everyday pet fur."}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"title","label":"Title","default":"Reusable, not disposable"},{"type":"textarea","id":"text","label":"Text","default":"Roll, empty, repeat — no sticky sheets to rebuy."}]}],"presets":[{"name":"Benefits","blocks":[{"type":"benefit","settings":{"title":"Reusable, not disposable","text":"Roll, empty, repeat — no sticky sheets to rebuy."}},{"type":"benefit","settings":{"title":"Works where fur lives","text":"Couches, clothing, bedding and car seats."}},{"type":"benefit","settings":{"title":"Zero hassle","text":"No batteries, no charging, no setup."}}]}]}{% endschema %}
