<section id="why-furvero" class="section alt"><div class="container section-head"><div class="eyebrow">WHY FURVERO</div><h2>{{ section.settings.heading }}</h2></div><div class="container cards">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<article class="card" {{ block.shopify_attributes }}><div class="number">0{{ forloop.index }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}{% else %}<article class="card"><div class="number">01</div><h3>Reusable</h3><p>Use it again for everyday cleanup.</p></article><article class="card"><div class="number">02</div><h3>Simple</h3><p>No batteries, charging or complicated setup.</p></article><article class="card"><div class="number">03</div><h3>Convenient</h3><p>Keep it nearby for quick touch-ups.</p></article>{% endif %}</div></section>
{% schema %}{"name":"Benefits","settings":[{"type":"text","id":"heading","label":"Heading","default":"A simpler way to deal with everyday pet fur."}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"title","label":"Title","default":"Reusable"},{"type":"textarea","id":"text","label":"Text","default":"Use it again instead of relying on disposable sticky sheets."}]}],"presets":[{"name":"Benefits","blocks":[{"type":"benefit","settings":{"title":"Reusable","text":"Use it again for everyday cleanup."}},{"type":"benefit","settings":{"title":"Simple","text":"No batteries, charging or complicated setup."}},{"type":"benefit","settings":{"title":"Convenient","text":"Keep it nearby for quick touch-ups."}}]}]}{% endschema %}
