<section id="why-furvero" class="section alt"><div class="container section-head"><div class="eyebrow">WHY FURVERO</div><h2>{{ section.settings.heading }}</h2></div><div class="container cards">{% for block in section.blocks %}<article class="card" {{ block.shopify_attributes }}><div class="number">0{{ forloop.index }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></section>
{% schema %}{"name":"Benefits","settings":[{"type":"text","id":"heading","label":"Heading","default":"A simpler way to deal with everyday pet fur."}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"title","label":"Title","default":"Reusable"},{"type":"textarea","id":"text","label":"Text","default":"Use it again instead of relying on disposable sticky sheets."}]}],"presets":[{"name":"Benefits","blocks":[{"type":"benefit","settings":{"title":"Reusable","text":"Use it again for everyday cleanup."}},{"type":"benefit","settings":{"title":"Simple","text":"No batteries, charging or complicated setup."}},{"type":"benefit","settings":{"title":"Convenient","text":"Keep it nearby for quick touch-ups."}}]}]}{% endschema %}
