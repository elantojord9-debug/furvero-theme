{{- 'guarantee — FURVERO PROMISE pillars. No invented policy:
    the returns pillar links to the REAL policy page once configured.' -}}
<section class="fv-section fv-section--cream">
  <div class="fv-container">
    <div class="fv-center">
      <span class="fv-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="fv-h2">{{ section.settings.headline }}</h2>
    </div>
    <div class="fv-guarantee__grid">
      {%- for block in section.blocks -%}
        <div class="fv-guarantee__item">
          <h3>{{ block.settings.title }}</h3>
          <p>
            {{ block.settings.text }}
            {%- if block.settings.link_policy and section.settings.policy_url != blank -%}
              <br><a href="{{ section.settings.policy_url }}">Read our policy</a>
            {%- endif -%}
          </p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OUR PROMISE" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "THE FURVERO PROMISE" },
    { "type": "url", "id": "policy_url", "label": "Return policy page", "info": "Required before launch — the 'Straightforward returns' pillar links here." }
  ],
  "blocks": [
    {
      "type": "pillar", "name": "Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "CLEAR PRODUCT INFORMATION" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "What you see is what you get." },
        { "type": "checkbox", "id": "link_policy", "label": "Link to return policy", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guarantee",
      "blocks": [
        { "type": "pillar", "settings": { "title": "CLEAR PRODUCT INFORMATION", "text": "Honest details about what Furvero is and what it does." } },
        { "type": "pillar", "settings": { "title": "SECURE CHECKOUT", "text": "Encrypted checkout through Shopify." } },
        { "type": "pillar", "settings": { "title": "TRANSPARENT SHIPPING", "text": "Delivery estimates shown before you pay." } },
        { "type": "pillar", "settings": { "title": "STRAIGHTFORWARD RETURNS", "text": "Our return policy, in plain language.", "link_policy": true } }
      ]
    }
  ]
}
{% endschema %}
