<!-- FURVERO bundle-offer section -->
{{- 'bundle offer — tiered pricing wired to REAL variant IDs (settings).
    The tiers ($19.99 / $29.99 / $39.99) are real prices from the brief,
    NOT a quantity multiple — so each option maps to a Shopify variant.
    If a variant ID is empty, that option shows an honest notice instead
    of charging a wrong price. See PRODUCT-SETUP.md for variant setup.' -}}
<section class="fv-section">
  <div class="fv-container">
    <div class="fv-center">
      <span class="fv-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="fv-h2">{{ section.settings.headline }}</h2>
      <p class="fv-lead">{{ section.settings.subhead }}</p>
    </div>

    <div class="fv-bundles" role="radiogroup" aria-label="Bundle options" data-fv-bundles>
      {%- for block in section.blocks -%}
        <label class="fv-bundle{% if forloop.first %} fv-bundle--selected{% endif %}{% if block.settings.variant_id == blank %} fv-bundle--pending{% endif %}">
          <input type="radio" name="fv-bundle" value="{{ block.settings.variant_id }}"
                 {% if forloop.first %}checked{% endif %}
                 data-price="{{ block.settings.price }}"
                 data-qty="{{ block.settings.quantity }}">
          {%- if block.settings.flag != blank -%}
            <span class="fv-bundle__flag">{{ block.settings.flag }}</span>
          {%- endif -%}
          <h3>{{ block.settings.title }}</h3>
          <p class="fv-bundle__sub">{{ block.settings.subtitle }}</p>
          <p class="fv-bundle__price">{{ block.settings.price }}</p>
          <p class="fv-bundle__per">{{ block.settings.per_note }}</p>
          {%- if block.settings.variant_id == blank -%}
            <p class="fv-bundle__notice">Bundle options are being configured — please use ADD TO CART above.</p>
          {%- endif -%}
        </label>
      {%- endfor -%}
    </div>

    <div class="fv-bundle__cta">
      <button type="button" class="fv-btn fv-btn--primary" data-fv-bundle-add style="min-width: 280px;">
        {{ section.settings.cta_text | default: 'ADD BUNDLE TO CART' }}
      </button>
      <p class="fv-note" style="margin-top: 12px;">{{ section.settings.note }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BUNDLES" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "GET MORE. SAVE MORE." },
    { "type": "text", "id": "subhead", "label": "Subheadline", "default": "One for home, one for the car, one to gift." },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "ADD BUNDLE TO CART" },
    { "type": "text", "id": "note", "label": "Note under button", "default": "Secure checkout · Free U.S. shipping" }
  ],
  "blocks": [
    {
      "type": "option", "name": "Bundle option",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "1× FURVERO" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "EVERYDAY CLEANUP" },
        { "type": "text", "id": "price", "label": "Display price", "default": "$19.99" },
        { "type": "text", "id": "per_note", "label": "Per-unit note", "default": "$19.99 each" },
        { "type": "text", "id": "flag", "label": "Flag (e.g. MOST POPULAR)", "default": "" },
        { "type": "text", "id": "quantity", "label": "Quantity in bundle", "default": "1" },
        { "type": "text", "id": "variant_id", "label": "Shopify variant ID", "info": "Numeric variant ID from the product in Shopify admin (see PRODUCT-SETUP.md). Leave empty until the bundle variants are created." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle offer",
      "blocks": [
        { "type": "option", "settings": { "title": "1× FURVERO", "subtitle": "EVERYDAY CLEANUP", "price": "$19.99", "per_note": "$19.99 each", "flag": "", "quantity": "1", "variant_id": "" } },
        { "type": "option", "settings": { "title": "2× FURVERO", "subtitle": "HOME + CAR", "price": "$29.99", "per_note": "$15.00 each", "flag": "MOST POPULAR", "quantity": "2", "variant_id": "" } },
        { "type": "option", "settings": { "title": "3× FURVERO", "subtitle": "BEST VALUE", "price": "$39.99", "per_note": "$13.33 each", "flag": "BEST VALUE", "quantity": "3", "variant_id": "" } }
      ]
    }
  ]
}
{% endschema %}
