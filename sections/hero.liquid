<section class="hero"><div class="container hero-grid"><div><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p>{% if section.settings.product != blank %}{% assign p=section.settings.product %}<div class="price"><span class="price-from">From</span> {{ p.price | money }}</div><a class="btn btn-primary" href="#shop">{{ section.settings.button }}</a>{% endif %}<div class="trust"><span class="pill">Reusable</span><span class="pill">Battery-free</span><span class="pill">Everyday cleanup</span></div></div><div class="hero-media">{% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape | default: 'Furvero pet hair remover' | escape }}" loading="eager">{% elsif section.settings.product.featured_image %}<img src="{{ section.settings.product.featured_image | image_url: width: 1200 }}" alt="{{ section.settings.product.title | escape }}" loading="eager">{% endif %}</div></div></section>
{% schema %}{"name":"Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"LESS FUR. MORE LOVE."},{"type":"text","id":"heading","label":"Heading","default":"Pet Hair Everywhere? Not Anymore."},{"type":"textarea","id":"text","label":"Text","default":"The reusable roller that lifts pet fur off couches, clothing, bedding and more — no batteries, no refills, no sticky sheets."},{"type":"product","id":"product","label":"Product"},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"button","label":"Button","default":"GET MY FURVERO"}],"presets":[{"name":"Hero"}]}{% endschema %}
